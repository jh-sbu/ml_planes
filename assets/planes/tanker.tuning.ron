// Physics-scaled STARTER gains for orbit/heading_hold — NOT yet /tune-validated.
// Run `/tune assets/planes/tanker.plane.ron <controller>` to refine those across the envelope.
//
// level_hold."normal" passes all 5 envelope scenarios
// (200m/80–2000m/130 m·s⁻¹). NOTE: observe_state flies the dry 45 t airframe (it spawns
// mass=cfg.mass with infinite fuel), so these are tuned for 45 t — the live sim spawns the
// loaded ~135 t jet, which (being even more sluggish in pitch) may want still more pitch_kd.
// Its high pitch inertia requires strong inner-loop pitch-rate damping.
PlaneTuning(
    level_hold: {
        "normal": LevelHoldTuning(
            alt_kp: 0.015,
            alt_ki: 0.22,
            alt_kd: 0.20,
            pitch_kp: 2.0,
            pitch_kd: 8.0,
            spd_kp: 0.03,
            spd_ki: 0.15,
            throttle_ff_gain: 0.3,
        ),
    },
    orbit: {
        "normal": OrbitTuning(
            radial_kp: 0.002,
            radial_kd: 0.01,
            heading_kp: 0.7,
            heading_kd: 0.1,
            inner: LevelHoldTuning(
                alt_kp: 0.0078,
                alt_ki: 0.094,
                alt_kd: 0.031,
                pitch_kp: 1.000,
                pitch_kd: 0.500,
                spd_kp: 0.0247,
                spd_ki: 0.148,
                throttle_ff_gain: 0.7,
            ),
        ),
    },
    heading_hold: {
        "normal": HeadingHoldTuning(
            heading_kp: 0.7,
            heading_kd: 0.1,
            inner: LevelHoldTuning(
                alt_kp: 0.0078,
                alt_ki: 0.094,
                alt_kd: 0.031,
                pitch_kp: 1.000,
                pitch_kd: 0.500,
                spd_kp: 0.0247,
                spd_ki: 0.148,
                throttle_ff_gain: 0.7,
            ),
        ),
    },
    // Staged refueling approach (M13). Stations are in the TANKER's body frame
    // (+X fwd, +Y right, +Z up), so all three sit on the centerline (y = 0) behind and
    // below it. STARTER values — validate with
    //   cargo run --release --example observe_state --no-default-features -- \
    //     --scenario assets/scenarios/refueling.scenario.ron --steps 11520 --interval 64
    // before trusting them. `lateral_kp` is at the documented stability ceiling: the
    // lateral cascade is bandwidth-inverted (outer loop faster than inner), so raising it
    // buys oscillation, not precision.
    refueling: {
        "normal": RefuelingTuning(
            astern: (-150.0, 0.0, -30.0),
            precontact: (-40.0, 0.0, -10.0),
            contact: (-15.0, 0.0, -5.0),

            capture_radius: 12.0,
            contact_radius: 5.0,
            closure_tolerance: 2.0,
            dwell_secs: 3.0,
            abort_radius: 30.0,

            approach_rate: 4.0,
            breakaway_rate: 12.0,

            range_kp: 0.2,
            range_ki: 0.02,
            range_kd: 0.5,
            lateral_kp: 0.002,
            lateral_kd: 0.01,
            heading_kp: 0.7,
            heading_kd: 0.1,

            inner: LevelHoldTuning(
                alt_kp: 0.0078,
                alt_ki: 0.094,
                alt_kd: 0.031,
                pitch_kp: 1.000,
                pitch_kd: 0.500,
                spd_kp: 0.0247,
                spd_ki: 0.148,
                throttle_ff_gain: 0.7,
            ),
        ),
    },
)
