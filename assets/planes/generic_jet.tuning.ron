// Tuned PID gains for generic_jet.plane.ron.
// level_hold "normal" is validated at full fuel.
// Passes all 5 trim scenarios (200/80, 500/100, 1000/130, 2000/110,
// 300/70) with worst 30–60 s errors of ΔAlt 6.19 m and ΔSpd 0.27 m/s.
// Also recovers from all ±200 m / ±20 m/s combinations by 60 s without stalling.
PlaneTuning(
    level_hold: {
        "normal": LevelHoldTuning(
            alt_kp: 0.015,
            alt_ki: 0.22,
            alt_kd: 0.20,
            pitch_kp: 5.0,
            pitch_kd: 4.0,
            spd_kp: 0.03,
            spd_ki: 0.15,
            throttle_ff_gain: 0.3,
        ),
    },
    orbit: {
        "normal": OrbitTuning(
            radial_kp:  0.002,
            radial_kd:  0.01,
            heading_kp: 0.7,
            heading_kd: 0.1,
            inner: LevelHoldTuning(
                alt_kp:           0.01,
                alt_ki:           0.12,
                alt_kd:           0.04,
                pitch_kp:         1.000,
                pitch_kd:         0.500,
                spd_kp:           0.010,
                spd_ki:           0.06,
                throttle_ff_gain: 0.7,
            ),
        ),
    },
    heading_hold: {
        "normal": HeadingHoldTuning(
            heading_kp: 0.7,
            heading_kd: 0.1,
            inner: LevelHoldTuning(
                alt_kp:           0.01,
                alt_ki:           0.12,
                alt_kd:           0.04,
                pitch_kp:         1.000,
                pitch_kd:         0.500,
                spd_kp:           0.010,
                spd_ki:           0.06,
                throttle_ff_gain: 0.7,
            ),
        ),
    },
)
