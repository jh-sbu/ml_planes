// Tuned PID gains for generic_jet.plane.ron.
// level_hold "normal" is validated at full fuel.
// Passes all 5 trim scenarios (200/80, 500/100, 1000/130, 2000/110,
// 300/70) with worst 30–60 s errors of ΔAlt 6.19 m and ΔSpd 0.27 m/s.
// Also recovers from all ±200 m / ±20 m/s combinations by 60 s without stalling.
PlaneTuning(
    level_hold: {
        "normal": LevelHoldTuning(
            alt_kp: 0.015,
            alt_ki: 0.22,
            alt_kd: 0.20,
            pitch_kp: 5.0,
            pitch_kd: 4.0,
            spd_kp: 0.03,
            spd_ki: 0.15,
            throttle_ff_gain: 0.3,
        ),
    },
    orbit: {
        "normal": OrbitTuning(
            radial_kp:  0.002,
            radial_kd:  0.01,
            heading_kp: 0.7,
            heading_kd: 0.1,
            inner: LevelHoldTuning(
                alt_kp:           0.01,
                alt_ki:           0.12,
                alt_kd:           0.04,
                pitch_kp:         1.000,
                pitch_kd:         0.500,
                spd_kp:           0.010,
                spd_ki:           0.06,
                throttle_ff_gain: 0.7,
            ),
        ),
    },
    heading_hold: {
        "normal": HeadingHoldTuning(
            heading_kp: 0.7,
            heading_kd: 0.1,
            inner: LevelHoldTuning(
                alt_kp:           0.01,
                alt_ki:           0.12,
                alt_kd:           0.04,
                pitch_kp:         1.000,
                pitch_kd:         0.500,
                spd_kp:           0.010,
                spd_ki:           0.06,
                throttle_ff_gain: 0.7,
            ),
        ),
    },
    // Staged refueling approach (M13). Stations are in the TANKER's body frame
    // (+X fwd, +Y right, +Z up), so all three sit on the centerline (y = 0) behind and
    // below it. STARTER values — validate with
    //   cargo run --release --example observe_state --no-default-features -- \
    //     --scenario assets/scenarios/refueling.scenario.ron --steps 11520 --interval 64
    // before trusting them. `lateral_kp` is at the documented stability ceiling: the
    // lateral cascade is bandwidth-inverted (outer loop faster than inner), so raising it
    // buys oscillation, not precision.
    refueling: {
        "normal": RefuelingTuning(
            astern: (-150.0, 0.0, -30.0),
            precontact: (-40.0, 0.0, -10.0),
            contact: (-15.0, 0.0, -5.0),

            capture_radius: 12.0,
            contact_radius: 5.0,
            closure_tolerance: 2.0,
            dwell_secs: 3.0,
            abort_radius: 30.0,

            approach_rate: 4.0,
            breakaway_rate: 12.0,

            range_kp: 0.2,
            range_ki: 0.02,
            range_kd: 0.5,
            lateral_kp: 0.002,
            lateral_kd: 0.01,
            heading_kp: 0.7,
            heading_kd: 0.1,

            inner: LevelHoldTuning(
                alt_kp: 0.01,
                alt_ki: 0.12,
                alt_kd: 0.04,
                pitch_kp: 1.0,
                pitch_kd: 0.5,
                spd_kp: 0.01,
                spd_ki: 0.06,
                throttle_ff_gain: 0.7,
            ),
        ),
    },
)
