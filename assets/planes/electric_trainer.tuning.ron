// PID gains for electric_trainer.plane.ron.
// level_hold "normal" is validated across five trim points
// (200 m/55 m·s⁻¹, 300/50, 500/70, 1000/90, 2000/80) and ±200 m / ±20 m·s⁻¹
// recovery cases. Worst 40–60 s trim RMS: ΔAlt 0.78 m, ΔSpd 0.18 m/s.
// Orbit and heading_hold remain physics-scaled STARTER gains — NOT yet /tune-validated.
// Mass is constant (battery), so no fuel-burn lightening compensation is needed.
PlaneTuning(
    level_hold: {
        "normal": LevelHoldTuning(
            alt_kp: 0.0281,
            alt_ki: 0.412,
            alt_kd: 0.262,
            pitch_kp: 0.910,
            pitch_kd: 1.146,
            spd_kp: 0.16,
            spd_ki: 0.20,
            throttle_ff_gain: 0.3,
        ),
    },
    orbit: {
        "normal": OrbitTuning(
            radial_kp: 0.002,
            radial_kd: 0.01,
            heading_kp: 0.7,
            heading_kd: 0.1,
            inner: LevelHoldTuning(
                alt_kp: 0.0187,
                alt_ki: 0.224,
                alt_kd: 0.075,
                pitch_kp: 1.000,
                pitch_kd: 0.500,
                spd_kp: 0.026,
                spd_ki: 0.156,
                throttle_ff_gain: 0.7,
            ),
        ),
    },
    heading_hold: {
        "normal": HeadingHoldTuning(
            heading_kp: 0.7,
            heading_kd: 0.1,
            inner: LevelHoldTuning(
                alt_kp: 0.0187,
                alt_ki: 0.224,
                alt_kd: 0.075,
                pitch_kp: 1.000,
                pitch_kd: 0.500,
                spd_kp: 0.026,
                spd_ki: 0.156,
                throttle_ff_gain: 0.7,
            ),
        ),
    },
)
