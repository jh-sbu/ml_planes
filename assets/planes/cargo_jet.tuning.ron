// PID gains for cargo_jet.plane.ron.
// level_hold "normal" is validated across the flight envelope.
// orbit and heading_hold remain physics-scaled STARTER gains — NOT yet /tune-validated;
// run `/tune assets/planes/cargo_jet.plane.ron <controller>` to refine them.
PlaneTuning(
    level_hold: {
        // Validated across 5 envelope points (500/120, 1000/160, 2000/190,
        // 3000/170, 300/110); worst ΔAlt ≤ 3.6 m, worst ΔSpd ≤ 0.26 m/s.
        // Envelope floor is ~110 m/s: this loaded 218 t jet cannot hold level at
        // 100 m/s — it trims into a slow descent. Do not expect a 100 m/s hold.
        // ki·clamp must cover trim; the 218 t airframe needs strong pitch damping.
        "normal": LevelHoldTuning(
            alt_kp: 0.015,
            alt_ki: 0.22,
            alt_kd: 0.20,
            pitch_kp: 2.0,
            pitch_kd: 8.0,
            spd_kp: 0.04,
            spd_ki: 0.30,
            throttle_ff_gain: 0.3,
        ),
    },
    orbit: {
        "normal": OrbitTuning(
            radial_kp: 0.002,
            radial_kd: 0.01,
            heading_kp: 0.7,
            heading_kd: 0.1,
            inner: LevelHoldTuning(
                alt_kp: 0.0077,
                alt_ki: 0.092,
                alt_kd: 0.031,
                pitch_kp: 1.000,
                pitch_kd: 0.500,
                spd_kp: 0.022,
                spd_ki: 0.132,
                throttle_ff_gain: 0.7,
            ),
        ),
    },
    heading_hold: {
        "normal": HeadingHoldTuning(
            heading_kp: 0.7,
            heading_kd: 0.1,
            inner: LevelHoldTuning(
                alt_kp: 0.0077,
                alt_ki: 0.092,
                alt_kd: 0.031,
                pitch_kp: 1.000,
                pitch_kd: 0.500,
                spd_kp: 0.022,
                spd_ki: 0.132,
                throttle_ff_gain: 0.7,
            ),
        ),
    },
    // Staged refueling approach (M13). Stations are in the TANKER's body frame
    // (+X fwd, +Y right, +Z up), so all three sit on the centerline (y = 0) behind and
    // below it. STARTER values — validate with
    //   cargo run --release --example observe_state --no-default-features -- \
    //     --scenario assets/scenarios/refueling.scenario.ron --steps 11520 --interval 64
    // before trusting them. `lateral_kp` is at the documented stability ceiling: the
    // lateral cascade is bandwidth-inverted (outer loop faster than inner), so raising it
    // buys oscillation, not precision.
    refueling: {
        "normal": RefuelingTuning(
            astern: (-150.0, 0.0, -30.0),
            precontact: (-40.0, 0.0, -10.0),
            contact: (-15.0, 0.0, -5.0),

            capture_radius: 12.0,
            contact_radius: 5.0,
            closure_tolerance: 2.0,
            dwell_secs: 3.0,
            abort_radius: 30.0,

            approach_rate: 4.0,
            breakaway_rate: 12.0,

            range_kp: 0.2,
            range_ki: 0.02,
            range_kd: 0.5,
            lateral_kp: 0.002,
            lateral_kd: 0.01,
            heading_kp: 0.7,
            heading_kd: 0.1,

            inner: LevelHoldTuning(
                alt_kp: 0.0077,
                alt_ki: 0.092,
                alt_kd: 0.031,
                pitch_kp: 1.000,
                pitch_kd: 0.500,
                spd_kp: 0.022,
                spd_ki: 0.132,
                throttle_ff_gain: 0.7,
            ),
        ),
    },
)
