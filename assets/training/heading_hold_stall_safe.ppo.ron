// Fine-tuning parameters for heading_hold_stall_safe.reward.ron. Zero entropy
// assumes a converged warm start; lr 3e-5 allows behavior to move off cl_max.
(
    gamma: 0.99,
    gae_lambda: 0.95,
    clip_epsilon: 0.1,
    value_coef: 0.5,
    entropy_coef: 0.0,
    lr: 0.00003,
    rollout_steps: 4096,
    n_epochs: 4,
    minibatch: 64,
    seed: Some(44),
)
