// Fine-tuning parameters for heading_hold_coordinated.reward.ron. Zero entropy
// assumes a BC-pretrained policy; this is not the task default.
(
    gamma: 0.99,
    gae_lambda: 0.95,
    clip_epsilon: 0.1,
    value_coef: 0.5,
    entropy_coef: 0.0,
    lr: 0.00003,
    rollout_steps: 4096,
    n_epochs: 4,
    minibatch: 64,
    seed: Some(44),
)
