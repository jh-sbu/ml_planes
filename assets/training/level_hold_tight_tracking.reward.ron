// Optional level_hold profile for tighter steady-state tracking. It increases
// reward magnitude and is not the task default; pass it with `--reward-config`.
(
    alt_error_scale:    60.0,
    alt_error_weight:   1.0,
    speed_error_scale:  6.0,
    speed_error_weight: 0.5,
    roll_scale:         0.5,
    roll_weight:        0.3,
    beta_scale:         0.5,
    beta_weight:        0.1,
    alive_bonus:        0.01,
    min_altitude:       10.0,
    max_altitude_error: 500.0,
    max_episode_steps:  3200,
)
