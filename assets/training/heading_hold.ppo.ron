// Default PPO hyperparameters for heading_hold. The entropy bonus supports
// exploration from random initialization; use zero entropy for converged warm starts.
(
    gamma: 0.99,
    gae_lambda: 0.95,
    clip_epsilon: 0.1,
    value_coef: 0.5,
    entropy_coef: 0.005,
    lr: 0.0003,
    rollout_steps: 2048,
    n_epochs: 4,
    minibatch: 64,
    // seed: Some(1234),
)
