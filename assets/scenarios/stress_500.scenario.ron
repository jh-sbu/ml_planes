        // ------------------------------------------------------------------
        // Refueling pairs — 16 tankers, one receiver each (a second receiver would
        // chase the same station), z 15000..22500, 500 m apart. Tankers fly a half
        // tank at 130 m/s like refueling.scenario.ron; receivers spawn on the Astern
        // station (150 m aft, 30 m below) and fly the ladder from there. Receivers:
        // generic ×8, business ×5, cargo ×3 (a heavy receiving from a heavy). The
        // electric trainer cannot make 130 m/s, so it has no receiver slot.
        // observe_state never loads .tuning.ron, so headless these fly compiled
        // default gains; the live sim applies each airframe's `refueling` profile.
        (name: "refuel_tanker_1", config: "assets/planes/tanker.plane.ron", position: (-40000.0, 1800.0, 15000.0), velocity: (130.00, 0.0, 0.00), fuel_fraction: 0.50, controller: LevelHold(altitude: 1800.0, airspeed: 130.0)),
        (name: "refuel_generic_1", config: "assets/planes/generic_jet.plane.ron", position: (-40150.0, 1770.0, 15000.0), velocity: (130.00, 0.0, 0.00), controller: Refueling(tanker: "refuel_tanker_1")),
        (name: "refuel_tanker_2", config: "assets/planes/tanker.plane.ron", position: (-40000.0, 2000.0, 15500.0), velocity: (130.00, 0.0, 0.00), fuel_fraction: 0.50, controller: LevelHold(altitude: 2000.0, airspeed: 130.0)),
