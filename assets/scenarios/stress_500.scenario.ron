        (name: "orbit_b_5", config: "assets/planes/generic_jet.plane.ron", position: (-27000.0, 1500.0, 38200.0), heading_deg: 180.0, velocity: (-100.00, 0.0, 0.00), controller: Orbit(center_x: -27000.0, center_z: 35000.0, radius: 3200.0, direction: Clockwise, altitude: 1500.0, airspeed: 100.0)),
