        (name: "orbit_b_7", config: "assets/planes/generic_jet.plane.ron", position: (-27000.0, 1900.0, 39200.0), heading_deg: 180.0, velocity: (-100.00, 0.0, 0.00), controller: Orbit(center_x: -27000.0, center_z: 35000.0, radius: 4200.0, direction: Clockwise, altitude: 1900.0, airspeed: 100.0)),
        (name: "orbit_b_8", config: "assets/planes/generic_jet.plane.ron", position: (-27000.0, 2100.0, 39700.0), velocity: (100.00, 0.0, 0.00), controller: Orbit(center_x: -27000.0, center_z: 35000.0, radius: 4700.0, direction: CounterClockwise, altitude: 2100.0, airspeed: 100.0)),
        (name: "orbit_b_9", config: "assets/planes/generic_jet.plane.ron", position: (-27000.0, 2300.0, 40200.0), heading_deg: 180.0, velocity: (-100.00, 0.0, 0.00), controller: Orbit(center_x: -27000.0, center_z: 35000.0, radius: 5200.0, direction: Clockwise, altitude: 2300.0, airspeed: 100.0)),
        (name: "orbit_b_10", config: "assets/planes/generic_jet.plane.ron", position: (-27000.0, 2500.0, 40700.0), velocity: (100.00, 0.0, 0.00), controller: Orbit(center_x: -27000.0, center_z: 35000.0, radius: 5700.0, direction: CounterClockwise, altitude: 2500.0, airspeed: 100.0)),
        (name: "orbit_biz_1", config: "assets/planes/business_jet.plane.ron", position: (-9000.0, 600.0, 36800.0), velocity: (110.00, 0.0, 0.00), controller: Orbit(center_x: -9000.0, center_z: 35000.0, radius: 1800.0, direction: CounterClockwise, altitude: 600.0, airspeed: 110.0)),
