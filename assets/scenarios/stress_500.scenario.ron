// Stress test: 500 planes, every controller kind and all five airframes flying
// several of them each. Generated — the layout is regular on purpose, so edit a
// group's parameters as a whole rather than hand-tweaking single entries.
//
// Purpose is load, not flight quality: it pushes the fixed 64 Hz Rapier step,
// the per-entity controller update, ControllerContext's linear peer scan (136
// wingmen + 16 receivers each scanning 500 planes per tick), replication
// bandwidth, and the HUD/map/roster at 5x stress_100's plane count.
//
// Run headless (60 s of sim, one CSV sample per second per plane → ~30000 rows):
//   cargo run --release --example observe_state --no-default-features --features inference -- \
//     --scenario assets/scenarios/stress_500.scenario.ron --steps 3840 --interval 64
// Drop `--features inference` to exercise the 466 non-RL planes; the 34 RL planes
// then fail to build and are skipped (see `ResolvedScenario::build_controller`).
//
// Airframes (every plane names its config explicitly) and their speeds here:
//   generic_jet       168   100 m/s (130 on refueling / mixed-flight duty)
//   business_jet       95   110 m/s (100 on the patrol plan, 130 refueling)
//   electric_trainer   82    75 m/s — validated to ~90 m/s and ~2000 m
//   tanker             84   150 m/s (130 on refueling duty, half tank)
//   cargo_jet          71   160 m/s (130 as a receiver) — floor is ~110 m/s
//
// Controllers:
//   LevelHold    179
//   Wingman      102
//   Orbit         64
//   HeadingHold   56
//   Ascent        40
//   RlOrbit       18
//   RlLevelHold   16
//   Refueling     16
//   Manual         5
//   FlightPlan     4
//
// Layout (~100 x 115 km; groups are spaced so nothing interacts at spawn):
//   z ≈  52000         RL orbit hubs (generic)
//   z ≈  35000         PID orbit hubs, one per airframe, x -45000..45000
//   z   6000..24000    wingman lane B, refueling pairs, manual  ─┐ straight lanes,
//   z -11000..-3600    RL level columns, wingman lane A          │ all spawn at
//   z -38000..-12150   level-hold ladders, ascent climbers      ─┘ x ≈ -40000, fly +X
//   origin box         flight-plan followers (patrol.plan.ron)
//   z ≈ -58000         heading-hold rings, one per airframe
//
// Known/intentional interactions — planes have real colliders and nothing
// separates them, so these are part of the test:
//   * the heading-hold rings expand outward and reach the ladder lanes after
//     ~100 s; their altitudes overlap the upper ladders;
//   * the four flight-plan planes end up sharing the plan's terminal loiter;
//   * observe_state never loads .tuning.ron, so headless every non-generic
//     airframe flies compiled-default gains (the heavies porpoise; refueling
//     receivers may break away). The live sim applies each airframe's profiles.
(
    steps: 3840,
    interval: 64,
    planes: [
        // ------------------------------------------------------------------
        // RL orbit hubs — three hubs of six, z = 52000. Generic jets only: the
        // policies were trained on that airframe, so any other would measure
        // extrapolation. Radii 2600–4000 and altitudes 860–1160 stay inside the
        // trained envelope (see stress_100). Tangent spawn on the +Z side: heading
        // 0 for CCW, 180 for CW.
        (name: "rl_orbit_1_1", config: "assets/planes/generic_jet.plane.ron", position: (-15000.0, 860.0, 54600.0), velocity: (100.00, 0.0, 0.00), controller: RlOrbit(model: "models/orbit/ppo_orbit_1.mpk", center_x: -15000.0, center_z: 52000.0, radius: 2600.0, direction: CounterClockwise, altitude: 860.0, airspeed: 100.0)),
        (name: "rl_orbit_1_2", config: "assets/planes/generic_jet.plane.ron", position: (-15000.0, 920.0, 54880.0), heading_deg: 180.0, velocity: (-100.00, 0.0, 0.00), controller: RlOrbit(model: "models/orbit/ppo_orbit_1.mpk", center_x: -15000.0, center_z: 52000.0, radius: 2880.0, direction: Clockwise, altitude: 920.0, airspeed: 100.0)),
        (name: "rl_orbit_1_3", config: "assets/planes/generic_jet.plane.ron", position: (-15000.0, 980.0, 55160.0), velocity: (100.00, 0.0, 0.00), controller: RlOrbit(model: "models/orbit/ppo_orbit_1.mpk", center_x: -15000.0, center_z: 52000.0, radius: 3160.0, direction: CounterClockwise, altitude: 980.0, airspeed: 100.0)),
        (name: "rl_orbit_1_4", config: "assets/planes/generic_jet.plane.ron", position: (-15000.0, 1040.0, 55440.0), heading_deg: 180.0, velocity: (-100.00, 0.0, 0.00), controller: RlOrbit(model: "models/orbit/ppo_orbit_1.mpk", center_x: -15000.0, center_z: 52000.0, radius: 3440.0, direction: Clockwise, altitude: 1040.0, airspeed: 100.0)),
        (name: "rl_orbit_1_5", config: "assets/planes/generic_jet.plane.ron", position: (-15000.0, 1100.0, 55720.0), velocity: (100.00, 0.0, 0.00), controller: RlOrbit(model: "models/orbit/ppo_orbit_1.mpk", center_x: -15000.0, center_z: 52000.0, radius: 3720.0, direction: CounterClockwise, altitude: 1100.0, airspeed: 100.0)),
        (name: "rl_orbit_1_6", config: "assets/planes/generic_jet.plane.ron", position: (-15000.0, 1160.0, 56000.0), heading_deg: 180.0, velocity: (-100.00, 0.0, 0.00), controller: RlOrbit(model: "models/orbit/ppo_orbit_1.mpk", center_x: -15000.0, center_z: 52000.0, radius: 4000.0, direction: Clockwise, altitude: 1160.0, airspeed: 100.0)),
        (name: "rl_orbit_2_1", config: "assets/planes/generic_jet.plane.ron", position: (0.0, 860.0, 54600.0), velocity: (100.00, 0.0, 0.00), controller: RlOrbit(model: "models/orbit/ppo_orbit_1.mpk", center_x: 0.0, center_z: 52000.0, radius: 2600.0, direction: CounterClockwise, altitude: 860.0, airspeed: 100.0)),
        (name: "rl_orbit_2_2", config: "assets/planes/generic_jet.plane.ron", position: (0.0, 920.0, 54880.0), heading_deg: 180.0, velocity: (-100.00, 0.0, 0.00), controller: RlOrbit(model: "models/orbit/ppo_orbit_1.mpk", center_x: 0.0, center_z: 52000.0, radius: 2880.0, direction: Clockwise, altitude: 920.0, airspeed: 100.0)),
        (name: "rl_orbit_2_3", config: "assets/planes/generic_jet.plane.ron", position: (0.0, 980.0, 55160.0), velocity: (100.00, 0.0, 0.00), controller: RlOrbit(model: "models/orbit/ppo_orbit_1.mpk", center_x: 0.0, center_z: 52000.0, radius: 3160.0, direction: CounterClockwise, altitude: 980.0, airspeed: 100.0)),
        (name: "rl_orbit_2_4", config: "assets/planes/generic_jet.plane.ron", position: (0.0, 1040.0, 55440.0), heading_deg: 180.0, velocity: (-100.00, 0.0, 0.00), controller: RlOrbit(model: "models/orbit/ppo_orbit_1.mpk", center_x: 0.0, center_z: 52000.0, radius: 3440.0, direction: Clockwise, altitude: 1040.0, airspeed: 100.0)),
        (name: "rl_orbit_2_5", config: "assets/planes/generic_jet.plane.ron", position: (0.0, 1100.0, 55720.0), velocity: (100.00, 0.0, 0.00), controller: RlOrbit(model: "models/orbit/ppo_orbit_1.mpk", center_x: 0.0, center_z: 52000.0, radius: 3720.0, direction: CounterClockwise, altitude: 1100.0, airspeed: 100.0)),
        (name: "rl_orbit_2_6", config: "assets/planes/generic_jet.plane.ron", position: (0.0, 1160.0, 56000.0), heading_deg: 180.0, velocity: (-100.00, 0.0, 0.00), controller: RlOrbit(model: "models/orbit/ppo_orbit_1.mpk", center_x: 0.0, center_z: 52000.0, radius: 4000.0, direction: Clockwise, altitude: 1160.0, airspeed: 100.0)),
        (name: "rl_orbit_3_1", config: "assets/planes/generic_jet.plane.ron", position: (15000.0, 860.0, 54600.0), velocity: (100.00, 0.0, 0.00), controller: RlOrbit(model: "models/orbit/ppo_orbit_1.mpk", center_x: 15000.0, center_z: 52000.0, radius: 2600.0, direction: CounterClockwise, altitude: 860.0, airspeed: 100.0)),
        (name: "rl_orbit_3_2", config: "assets/planes/generic_jet.plane.ron", position: (15000.0, 920.0, 54880.0), heading_deg: 180.0, velocity: (-100.00, 0.0, 0.00), controller: RlOrbit(model: "models/orbit/ppo_orbit_1.mpk", center_x: 15000.0, center_z: 52000.0, radius: 2880.0, direction: Clockwise, altitude: 920.0, airspeed: 100.0)),
        (name: "rl_orbit_3_3", config: "assets/planes/generic_jet.plane.ron", position: (15000.0, 980.0, 55160.0), velocity: (100.00, 0.0, 0.00), controller: RlOrbit(model: "models/orbit/ppo_orbit_1.mpk", center_x: 15000.0, center_z: 52000.0, radius: 3160.0, direction: CounterClockwise, altitude: 980.0, airspeed: 100.0)),
        (name: "rl_orbit_3_4", config: "assets/planes/generic_jet.plane.ron", position: (15000.0, 1040.0, 55440.0), heading_deg: 180.0, velocity: (-100.00, 0.0, 0.00), controller: RlOrbit(model: "models/orbit/ppo_orbit_1.mpk", center_x: 15000.0, center_z: 52000.0, radius: 3440.0, direction: Clockwise, altitude: 1040.0, airspeed: 100.0)),
        (name: "rl_orbit_3_5", config: "assets/planes/generic_jet.plane.ron", position: (15000.0, 1100.0, 55720.0), velocity: (100.00, 0.0, 0.00), controller: RlOrbit(model: "models/orbit/ppo_orbit_1.mpk", center_x: 15000.0, center_z: 52000.0, radius: 3720.0, direction: CounterClockwise, altitude: 1100.0, airspeed: 100.0)),
        (name: "rl_orbit_3_6", config: "assets/planes/generic_jet.plane.ron", position: (15000.0, 1160.0, 56000.0), heading_deg: 180.0, velocity: (-100.00, 0.0, 0.00), controller: RlOrbit(model: "models/orbit/ppo_orbit_1.mpk", center_x: 15000.0, center_z: 52000.0, radius: 4000.0, direction: Clockwise, altitude: 1160.0, airspeed: 100.0)),

        // ------------------------------------------------------------------
        // RL level-hold columns — two columns of eight, 4 km apart in X, flying
        // +X at 100 m/s. Targets 900–1100 m (trained target 1000).
        (name: "rl_level_1_1", config: "assets/planes/generic_jet.plane.ron", position: (-40000.0, 900.0, -11000.0), velocity: (100.00, 0.0, 0.00), controller: RlLevelHold(model: "models/level_hold/ppo_level_hold.mpk", altitude: 900.0, airspeed: 100.0)),
        (name: "rl_level_1_2", config: "assets/planes/generic_jet.plane.ron", position: (-40000.0, 928.6, -10900.0), velocity: (100.00, 0.0, 0.00), controller: RlLevelHold(model: "models/level_hold/ppo_level_hold.mpk", altitude: 928.6, airspeed: 100.0)),
        (name: "rl_level_1_3", config: "assets/planes/generic_jet.plane.ron", position: (-40000.0, 957.1, -10800.0), velocity: (100.00, 0.0, 0.00), controller: RlLevelHold(model: "models/level_hold/ppo_level_hold.mpk", altitude: 957.1, airspeed: 100.0)),
        (name: "rl_level_1_4", config: "assets/planes/generic_jet.plane.ron", position: (-40000.0, 985.7, -10700.0), velocity: (100.00, 0.0, 0.00), controller: RlLevelHold(model: "models/level_hold/ppo_level_hold.mpk", altitude: 985.7, airspeed: 100.0)),
        (name: "rl_level_1_5", config: "assets/planes/generic_jet.plane.ron", position: (-40000.0, 1014.3, -10600.0), velocity: (100.00, 0.0, 0.00), controller: RlLevelHold(model: "models/level_hold/ppo_level_hold.mpk", altitude: 1014.3, airspeed: 100.0)),
        (name: "rl_level_1_6", config: "assets/planes/generic_jet.plane.ron", position: (-40000.0, 1042.9, -10500.0), velocity: (100.00, 0.0, 0.00), controller: RlLevelHold(model: "models/level_hold/ppo_level_hold.mpk", altitude: 1042.9, airspeed: 100.0)),
        (name: "rl_level_1_7", config: "assets/planes/generic_jet.plane.ron", position: (-40000.0, 1071.4, -10400.0), velocity: (100.00, 0.0, 0.00), controller: RlLevelHold(model: "models/level_hold/ppo_level_hold.mpk", altitude: 1071.4, airspeed: 100.0)),
        (name: "rl_level_1_8", config: "assets/planes/generic_jet.plane.ron", position: (-40000.0, 1100.0, -10300.0), velocity: (100.00, 0.0, 0.00), controller: RlLevelHold(model: "models/level_hold/ppo_level_hold.mpk", altitude: 1100.0, airspeed: 100.0)),
        (name: "rl_level_2_1", config: "assets/planes/generic_jet.plane.ron", position: (-36000.0, 900.0, -11000.0), velocity: (100.00, 0.0, 0.00), controller: RlLevelHold(model: "models/level_hold/ppo_level_hold.mpk", altitude: 900.0, airspeed: 100.0)),
        (name: "rl_level_2_2", config: "assets/planes/generic_jet.plane.ron", position: (-36000.0, 928.6, -10900.0), velocity: (100.00, 0.0, 0.00), controller: RlLevelHold(model: "models/level_hold/ppo_level_hold.mpk", altitude: 928.6, airspeed: 100.0)),
        (name: "rl_level_2_3", config: "assets/planes/generic_jet.plane.ron", position: (-36000.0, 957.1, -10800.0), velocity: (100.00, 0.0, 0.00), controller: RlLevelHold(model: "models/level_hold/ppo_level_hold.mpk", altitude: 957.1, airspeed: 100.0)),
        (name: "rl_level_2_4", config: "assets/planes/generic_jet.plane.ron", position: (-36000.0, 985.7, -10700.0), velocity: (100.00, 0.0, 0.00), controller: RlLevelHold(model: "models/level_hold/ppo_level_hold.mpk", altitude: 985.7, airspeed: 100.0)),
        (name: "rl_level_2_5", config: "assets/planes/generic_jet.plane.ron", position: (-36000.0, 1014.3, -10600.0), velocity: (100.00, 0.0, 0.00), controller: RlLevelHold(model: "models/level_hold/ppo_level_hold.mpk", altitude: 1014.3, airspeed: 100.0)),
        (name: "rl_level_2_6", config: "assets/planes/generic_jet.plane.ron", position: (-36000.0, 1042.9, -10500.0), velocity: (100.00, 0.0, 0.00), controller: RlLevelHold(model: "models/level_hold/ppo_level_hold.mpk", altitude: 1042.9, airspeed: 100.0)),
        (name: "rl_level_2_7", config: "assets/planes/generic_jet.plane.ron", position: (-36000.0, 1071.4, -10400.0), velocity: (100.00, 0.0, 0.00), controller: RlLevelHold(model: "models/level_hold/ppo_level_hold.mpk", altitude: 1071.4, airspeed: 100.0)),
        (name: "rl_level_2_8", config: "assets/planes/generic_jet.plane.ron", position: (-36000.0, 1100.0, -10300.0), velocity: (100.00, 0.0, 0.00), controller: RlLevelHold(model: "models/level_hold/ppo_level_hold.mpk", altitude: 1100.0, airspeed: 100.0)),

        // ------------------------------------------------------------------
        // PID orbit hubs — one row at z = 35000, 18 km apart, one hub per airframe
        // (generic gets two). Each airframe flies at its own speed, and the inner
        // radius is sized so the feed-forward bank atan(V²/gR) starts at ~33°:
        //   generic   100 m/s  r 1200–5700 (the 40° inner ring is stress_100's)
        //   business  110 m/s  r 1800–6200      electric   75 m/s  r  900–3650
        //   tanker    150 m/s  r 3500–6650      cargo     160 m/s  r 4000–7150
        // Concentric rings alternate direction; every ring has its own altitude.
        (name: "orbit_a_1", config: "assets/planes/generic_jet.plane.ron", position: (-45000.0, 600.0, 36200.0), velocity: (100.00, 0.0, 0.00), controller: Orbit(center_x: -45000.0, center_z: 35000.0, radius: 1200.0, direction: CounterClockwise, altitude: 600.0, airspeed: 100.0)),
        (name: "orbit_a_2", config: "assets/planes/generic_jet.plane.ron", position: (-45000.0, 800.0, 36700.0), heading_deg: 180.0, velocity: (-100.00, 0.0, 0.00), controller: Orbit(center_x: -45000.0, center_z: 35000.0, radius: 1700.0, direction: Clockwise, altitude: 800.0, airspeed: 100.0)),
        (name: "orbit_a_3", config: "assets/planes/generic_jet.plane.ron", position: (-45000.0, 1000.0, 37200.0), velocity: (100.00, 0.0, 0.00), controller: Orbit(center_x: -45000.0, center_z: 35000.0, radius: 2200.0, direction: CounterClockwise, altitude: 1000.0, airspeed: 100.0)),
        (name: "orbit_a_4", config: "assets/planes/generic_jet.plane.ron", position: (-45000.0, 1200.0, 37700.0), heading_deg: 180.0, velocity: (-100.00, 0.0, 0.00), controller: Orbit(center_x: -45000.0, center_z: 35000.0, radius: 2700.0, direction: Clockwise, altitude: 1200.0, airspeed: 100.0)),
        (name: "orbit_a_5", config: "assets/planes/generic_jet.plane.ron", position: (-45000.0, 1400.0, 38200.0), velocity: (100.00, 0.0, 0.00), controller: Orbit(center_x: -45000.0, center_z: 35000.0, radius: 3200.0, direction: CounterClockwise, altitude: 1400.0, airspeed: 100.0)),
        (name: "orbit_a_6", config: "assets/planes/generic_jet.plane.ron", position: (-45000.0, 1600.0, 38700.0), heading_deg: 180.0, velocity: (-100.00, 0.0, 0.00), controller: Orbit(center_x: -45000.0, center_z: 35000.0, radius: 3700.0, direction: Clockwise, altitude: 1600.0, airspeed: 100.0)),
        (name: "orbit_a_7", config: "assets/planes/generic_jet.plane.ron", position: (-45000.0, 1800.0, 39200.0), velocity: (100.00, 0.0, 0.00), controller: Orbit(center_x: -45000.0, center_z: 35000.0, radius: 4200.0, direction: CounterClockwise, altitude: 1800.0, airspeed: 100.0)),
