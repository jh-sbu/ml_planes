        (name: "orbit_biz_3", config: "assets/planes/business_jet.plane.ron", position: (-9000.0, 900.0, 37600.0), velocity: (110.00, 0.0, 0.00), controller: Orbit(center_x: -9000.0, center_z: 35000.0, radius: 2600.0, direction: CounterClockwise, altitude: 900.0, airspeed: 110.0)),
