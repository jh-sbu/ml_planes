        (name: "orbit_a_9", config: "assets/planes/generic_jet.plane.ron", position: (-45000.0, 2200.0, 40200.0), velocity: (100.00, 0.0, 0.00), controller: Orbit(center_x: -45000.0, center_z: 35000.0, radius: 5200.0, direction: CounterClockwise, altitude: 2200.0, airspeed: 100.0)),
        (name: "orbit_a_10", config: "assets/planes/generic_jet.plane.ron", position: (-45000.0, 2400.0, 40700.0), heading_deg: 180.0, velocity: (-100.00, 0.0, 0.00), controller: Orbit(center_x: -45000.0, center_z: 35000.0, radius: 5700.0, direction: Clockwise, altitude: 2400.0, airspeed: 100.0)),
        (name: "orbit_b_1", config: "assets/planes/generic_jet.plane.ron", position: (-27000.0, 700.0, 36200.0), heading_deg: 180.0, velocity: (-100.00, 0.0, 0.00), controller: Orbit(center_x: -27000.0, center_z: 35000.0, radius: 1200.0, direction: Clockwise, altitude: 700.0, airspeed: 100.0)),
        (name: "orbit_b_2", config: "assets/planes/generic_jet.plane.ron", position: (-27000.0, 900.0, 36700.0), velocity: (100.00, 0.0, 0.00), controller: Orbit(center_x: -27000.0, center_z: 35000.0, radius: 1700.0, direction: CounterClockwise, altitude: 900.0, airspeed: 100.0)),
        (name: "orbit_b_3", config: "assets/planes/generic_jet.plane.ron", position: (-27000.0, 1100.0, 37200.0), heading_deg: 180.0, velocity: (-100.00, 0.0, 0.00), controller: Orbit(center_x: -27000.0, center_z: 35000.0, radius: 2200.0, direction: Clockwise, altitude: 1100.0, airspeed: 100.0)),
