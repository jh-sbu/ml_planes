        // ------------------------------------------------------------------
        // Manual — one per airframe at z = 24000. No stick input headless, so these
        // fly a zero-throttle arc into the ground and stay in the entity count
        // (ground contact has no auto-removal), keeping the passthrough path live.
        (name: "manual_generic", config: "assets/planes/generic_jet.plane.ron", position: (-40000.0, 1500.0, 24000.0), velocity: (100.00, 0.0, 0.00), controller: Manual),
        (name: "manual_business", config: "assets/planes/business_jet.plane.ron", position: (-40000.0, 1650.0, 24300.0), velocity: (110.00, 0.0, 0.00), controller: Manual),
        (name: "manual_electric", config: "assets/planes/electric_trainer.plane.ron", position: (-40000.0, 1800.0, 24600.0), velocity: (75.00, 0.0, 0.00), controller: Manual),
        (name: "manual_tanker", config: "assets/planes/tanker.plane.ron", position: (-40000.0, 1950.0, 24900.0), velocity: (150.00, 0.0, 0.00), controller: Manual),
        (name: "manual_cargo", config: "assets/planes/cargo_jet.plane.ron", position: (-40000.0, 2100.0, 25200.0), velocity: (160.00, 0.0, 0.00), controller: Manual),

        // ------------------------------------------------------------------
        // Flight-plan followers — patrol.plan.ron from four corners of the origin
        // box, out of phase. The plan commands 100 m/s, which both the generic and
        // the business jet can hold. Kept to four: the plan's terminal loiter is one
        // fixed circle, so these share it once they finish (~220 s in).
        (name: "plan_generic_1", config: "assets/planes/generic_jet.plane.ron", position: (2000.0, 1000.0, 2000.0), heading_deg: -135.0, velocity: (-70.71, 0.0, -70.71), controller: FlightPlan(plan: "assets/plans/patrol.plan.ron")),
        (name: "plan_generic_2", config: "assets/planes/generic_jet.plane.ron", position: (-2000.0, 1150.0, -2000.0), heading_deg: 45.0, velocity: (70.71, 0.0, 70.71), controller: FlightPlan(plan: "assets/plans/patrol.plan.ron")),
        (name: "plan_business_1", config: "assets/planes/business_jet.plane.ron", position: (-2000.0, 1300.0, 2000.0), heading_deg: -45.0, velocity: (70.71, 0.0, -70.71), controller: FlightPlan(plan: "assets/plans/patrol.plan.ron")),
        (name: "plan_business_2", config: "assets/planes/business_jet.plane.ron", position: (2000.0, 1450.0, -2000.0), heading_deg: 135.0, velocity: (-70.71, 0.0, 70.71), controller: FlightPlan(plan: "assets/plans/patrol.plan.ron")),
    ],
