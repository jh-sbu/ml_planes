// Fleet demo: one of every airframe flying level in a line-abreast formation.
// The planes use independent level-hold controllers rather than leader/follower
// guidance, so they simply start next to one another with the same velocity and
// targets. Exercises every .plane.ron config and its "normal" level_hold tuning.
//
// Run: cargo run --example observe_state --no-default-features -- \
//        --scenario assets/scenarios/fleet_demo.scenario.ron --steps 3840 --interval 64
//
// Each plane spawns on-condition (spawn altitude = level-hold target, spawn velocity =
// target airspeed along +X) so level-hold engages cleanly. 120 m/s is above the cargo
// jet's loaded envelope floor while remaining attainable by the electric trainer.
(
    steps: 3840,
    interval: 64,
    planes: [
        (
            name: "electric_trainer",
            config: "assets/planes/electric_trainer.plane.ron",
            position: (0.0, 1000.0, -120.0),
            velocity: (120.0, 0.0, 0.0),
            controller: LevelHold(
                altitude: 1000.0,
                airspeed: 120.0,
            ),
        ),
        (
            name: "generic_jet",
            config: "assets/planes/generic_jet.plane.ron",
            position: (0.0, 1000.0, -60.0),
            velocity: (120.0, 0.0, 0.0),
            controller: LevelHold(
                altitude: 1000.0,
                airspeed: 120.0,
            ),
        ),
        (
            name: "business_jet",
            config: "assets/planes/business_jet.plane.ron",
            position: (0.0, 1000.0, 0.0),
            velocity: (120.0, 0.0, 0.0),
            controller: LevelHold(
                altitude: 1000.0,
                airspeed: 120.0,
            ),
        ),
        (
            name: "tanker",
            config: "assets/planes/tanker.plane.ron",
            position: (0.0, 1000.0, 60.0),
            velocity: (120.0, 0.0, 0.0),
            controller: LevelHold(
                altitude: 1000.0,
                airspeed: 120.0,
            ),
        ),
        (
            name: "cargo_jet",
            config: "assets/planes/cargo_jet.plane.ron",
            position: (0.0, 1000.0, 120.0),
            velocity: (120.0, 0.0, 0.0),
            controller: LevelHold(
                altitude: 1000.0,
                airspeed: 120.0,
            ),
        ),
    ],
)
