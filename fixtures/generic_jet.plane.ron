// TEST FIXTURE — frozen generic-jet airframe, used only by the test suite.
//
// This file is deliberately NOT kept in sync with `assets/planes/*.plane.ron` and does
// not necessarily reflect the values the live sim flies. Tests pin numeric expectations
// against these numbers, so editing them changes what those tests mean; treat a change
// here as a change to the tests, not as a config update.
//
// Coverage that the *shipped* airframes stay valid and sign-correct lives in
// `tests/core/plane_assets.rs`, which globs `assets/planes/` and never reads this file.
// That separation is the point: retuning a shipped airframe must not silently move a
// unit test's expected torque, and conversely this fixture must never be mistaken for
// a flyable asset.
//
// Values below were snapshotted from `assets/planes/generic_jet.plane.ron`.
(
    // --- Geometry ---
    wing_area: 20.0,        // S  [m²]
    mean_chord: 2.0,        // c̄  [m]
    wing_span: 10.0,        // b  [m]

    // --- Mass / Inertia ---
    mass: 5000.0,           // [kg] DRY / empty mass — fuel (see powerplant) adds on top.
    inertia: (10000.0, 40000.0, 45000.0), // Ixx, Iyy, Izz [kg·m²]

    // --- Longitudinal Aerodynamic Coefficients ---
    cl0: 0.1,
    cl_alpha: 4.5,
    cl_delta_e: 0.4,
    cl_max: 1.4,

    cd0: 0.02,
    cd_induced: 0.05,

    cm0: -0.02,
    cm_alpha: 0.6,
    cm_q: -14.0,
    cm_delta_e: -1.2,

    // --- Lateral-Directional Coefficients ---
    cl_beta: 0.08,
    cl_p: -0.45,
    cl_r: -0.12,
    cl_delta_a: 0.18,

    cn_beta: 0.10,
    cn_r: -0.12,
    cn_delta_r: -0.10,

    // Side force. Fin is aft of the CG, so each cy_* is the opposite sign of its
    // cn_* partner; cy_p is the one derivative whose sign flips vs NED references.
    cy_beta: -0.80,
    cy_p: 0.05,
    cy_r: 0.25,
    cy_delta_r: 0.18,

    // --- Engine ---
    thrust_max: 60000.0,    // [N] at throttle = 1.0

    // --- Powerplant (consumable) ---
    powerplant: JetFuel(capacity_kg: 2000.0, tsfc: 2.0e-5, fuel_type: JetA),

    // --- Control Limits ---
    aileron_limit: 0.4363,  // [rad] ≈ 25°
    elevator_limit: 0.3491, // [rad] ≈ 20°
    rudder_limit: 0.2618,   // [rad] ≈ 15°
)
